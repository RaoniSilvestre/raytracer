layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Raytracer" focus=true {
        pane edit="." 
        
        pane size="30%" split_direction="vertical" {
            pane command="just" {
                args "watch"
            }
            pane command="just" {
                args "watch-test"
            }
        }
    }
}
